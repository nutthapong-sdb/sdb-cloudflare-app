# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vendor
/public/tinymce
*.doc
*.csv
/.agents

# Local runtime data (do not commit)
/app/data/templates.json
/app/data/templates/

# SQLite transient files
*.db-shm
*.db-wal

# Local databases (do not commit)
/db/*.db
/db/*.db-shm
/db/*.db-wal

# Chrome Debug Profile
.chrome-debug-profile/
/chrome-config
/public
